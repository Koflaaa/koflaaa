<Window x:Class="UltraKaffee.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UltraKaffee"
        mc:Ignorable="d"
        Title="ULT-Kaffee" Height="360" Width="286" ResizeMode="CanMinimize">
    <Grid>
        <Image HorizontalAlignment="Left" Height="294" Margin="10,10,0,0" VerticalAlignment="Top" Width="246" Source="/kaffee_htg.png" Stretch="Fill"/>
        <Button Content=" A " HorizontalAlignment="Left" Margin="165,60,0,0" VerticalAlignment="Top" Click="Button_A_Click"/>
        <Button Content=" B " HorizontalAlignment="Left" Margin="212,60,0,0" VerticalAlignment="Top" Click="Button_B_Click"/>
        <Button x:Name="KMachen" Content="Kaffee machen" HorizontalAlignment="Left" Margin="133,205,0,0" VerticalAlignment="Top" Click="Button_Machen_Click" IsEnabled="False"/>
        <CheckBox x:Name="Box_Zucker" Content="" HorizontalAlignment="Left" Margin="212,237,0,0" VerticalAlignment="Top"/>
        <CheckBox x:Name="Box_Milch" Content="" HorizontalAlignment="Left" Margin="212,266,0,0" VerticalAlignment="Top"/>
        <RadioButton Content="" HorizontalAlignment="Left" Margin="90,237,0,0" VerticalAlignment="Top" IsChecked="True"/>
        <RadioButton Content="" HorizontalAlignment="Left" Margin="90,269,0,0" VerticalAlignment="Top"/>
        <Button Content="Auffüllen" HorizontalAlignment="Left" Margin="164,165,0,0" VerticalAlignment="Top" Click="Button_Fuellen_Click"/>
        <Label x:Name="Kaffee" Content="0" HorizontalAlignment="Left" Margin="82,123,0,0" VerticalAlignment="Top"/>
        <Label x:Name="Wasser" Content="0" HorizontalAlignment="Left" Margin="82,139,0,0" VerticalAlignment="Top"/>
        <Label x:Name="Zucker" Content="0" HorizontalAlignment="Left" Margin="186,123,0,0" VerticalAlignment="Top"/>
        <Label x:Name="Milch" Content="500" HorizontalAlignment="Left" Margin="186,139,0,0" VerticalAlignment="Top"/>
        <Label x:Name="MaschineStatus" Content="X" HorizontalAlignment="Left" Margin="84,162,0,0" VerticalAlignment="Top" FontWeight="Bold"/>
        <Label x:Name="Wahl" Content="Maschine A" HorizontalAlignment="Left" Margin="147,94,0,0" VerticalAlignment="Top" FontWeight="Bold" FontSize="14"/>

    </Grid>
</Window>
