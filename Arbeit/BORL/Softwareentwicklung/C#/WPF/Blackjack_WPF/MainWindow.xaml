<Window x:Class="Blackjack_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Blackjack_WPF"
        mc:Ignorable="d"
        Title="BLackJack" Height="500" Width="360">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10">
            <TextBlock Text="BlackJack" FontSize="24" FontWeight="Bold" TextAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
                <Button Name="btnHit" Content="Hit" Width="75" Margin="5" Click="btnHit_Click"/>
                <Button Name="btnStand" Content="Stand" Width="75" Margin="5" Click="btnStand_Click"/>
                <Button Name="btnRestart" Content="Restart" Width="75" Margin="5" Click="btnRestart_Click"/>
            </StackPanel>
            <TextBlock Text="Spieler Karten:" FontSize="18" FontWeight="Bold" Margin="10"/>
            <ItemsControl Name="playerCards" Margin="10"/>
            <TextBlock Text="Spieler Punkte:" FontSize="18" FontWeight="Bold" Margin="10"/>
            <TextBlock Name="playerPoints" FontSize="18" FontWeight="Bold" Margin="10"/>
            <TextBlock Text="Dealer Karten:" FontSize="18" FontWeight="Bold" Margin="10"/>
            <ItemsControl Name="dealerCards" Margin="10"/>
            <TextBlock Text="Dealer Punkte:" FontSize="18" FontWeight="Bold" Margin="10"/>
            <TextBlock Name="dealerPoints" FontSize="18" FontWeight="Bold" Margin="10"/>
            <TextBlock Name="gameResult" FontSize="24" FontWeight="Bold" Margin="10" Foreground="Red"/>
        </StackPanel>
    </Grid>
</Window>
