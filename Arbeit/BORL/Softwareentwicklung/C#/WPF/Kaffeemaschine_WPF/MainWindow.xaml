<Window x:Class="Kaffeemaschine_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Kaffeemaschine_WPF"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <StackPanel>
            <TextBlock Text="Welche Maschine möchten Sie verwenden?" FontSize="16" Margin="10"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <RadioButton Content="Maschine 1" GroupName="Maschine" x:Name="Maschine1RadioButton" Margin="10"/>
                <RadioButton Content="Maschine 2" GroupName="Maschine" x:Name="Maschine2RadioButton" Margin="10"/>
            </StackPanel>

            <TextBlock Text="Was möchten Sie tun?" FontSize="16" Margin="10"/>
            <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                <Button Content="Bohnen auffüllen" Click="BohnenAuffuellen_Click" Margin="10"/>
                <Button Content="Wasser auffüllen" Click="WasserAuffuellen_Click" Margin="10"/>
                <Button Content="Kaffee machen" Click="KaffeeMachen_Click" Margin="10"/>
                <Button Content="Status anzeigen" Click="StatusAnzeigen_Click" Margin="10"/>
                <Button Content="Ausgleichen" Click="Ausgleichen_Click" Margin="10"/>
                <Button Content="Kaffee kaufen" Click="KaffeeKaufen_Click" Margin="10"/>
                <Button Content="Beenden" Click="Beenden_Click" Margin="10"/>
            </StackPanel>

            <TextBlock x:Name="OutputTextBlock" FontSize="14" Margin="10" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</Window>
