<Window x:Class="WPF_Wuerfelspiel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF_Wuerfelspiel"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800" Background="Lavender">
    <Grid>
        <Button x:Name ="Start" Content="Start" HorizontalAlignment="Left" Margin="315,12,0,0" VerticalAlignment="Top" Height="40" Width="75"  Click="Start_Click" Background="LimeGreen" FontWeight="Bold" FontSize="18" FontFamily="Times New Roman"/>
        <TextBlock HorizontalAlignment="Left" Margin="48,76,0,0" TextWrapping="Wrap" VerticalAlignment="Top" RenderTransformOrigin="0.008,-1.523" Height="17" Width="74" TextAlignment="center"><Run Language="de-de" Text="Player 1" FontWeight="Bold" FontSize="14" FontFamily="Times New Roman" /></TextBlock>
        <TextBlock HorizontalAlignment="Left" Margin="620,76,0,0" TextWrapping="Wrap" VerticalAlignment="Top" RenderTransformOrigin="0.008,-1.523" Height="17" Width="74" TextAlignment="center"><Run Language="de-de" Text="Player 2" FontWeight="Bold" FontSize="14" FontFamily="Times New Roman" /></TextBlock>
        <TextBlock x:Name="Player1_Name" HorizontalAlignment="Left" Margin="38,101,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Height="17" Width="88" TextAlignment="center" FontWeight="Bold" FontSize="14" FontFamily="Times New Roman" Background="Snow"/>
        <TextBlock x:Name="Player2_Name" HorizontalAlignment="Left" Margin="615,100,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Height="17" Width="88" TextAlignment="center" FontWeight="Bold" FontSize="14" FontFamily="Times New Roman" Background="Snow"/>
        <Button x:Name ="Reset" Content="Reset" HorizontalAlignment="Left" Margin="215,12,0,0" VerticalAlignment="Top" Height="40" Width="75" Click="Reset_Click" Background="LightSkyBlue" FontWeight="Bold" FontSize="18" FontFamily="Times New Roman"/>
        <Button x:Name ="Exit" Content="X" HorizontalAlignment="Left" Margin="415,12,0,0" VerticalAlignment="Top" Height="40" Width="75" Click="Exit_Click" Background="Crimson" FontWeight="Bold" FontSize="18" FontFamily="Times New Roman" />
        <TextBlock x:Name ="Player1_Points" HorizontalAlignment="Left" Margin="29,0,0,0" TextWrapping="Wrap" VerticalAlignment="Center" Height="107" Width="135" Background="Snow" FontWeight="Bold" FontSize="90" FontFamily="Times New Roman"><Run Language="de-de" Text="0"/></TextBlock>
        <TextBlock x:Name ="Player2_Points" HorizontalAlignment="Left" Margin="611,170,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Height="104" Width="147" Background="Snow" FontWeight="Bold" FontSize="90" FontFamily="Times New Roman"><Run Language="de-de" Text="0"/></TextBlock>
        <TextBlock x:Name ="Dice1" HorizontalAlignment="Left" Margin="244,233,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Height="63" Width="63" TextAlignment="center" Background="Snow" FontWeight="Bold" FontSize="50" FontFamily="Times New Roman"><Run Language="de-de" Text="0"/></TextBlock>
        <TextBlock x:Name ="Dice2" HorizontalAlignment="Left" Margin="423,235,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Height="63" Width="63" TextAlignment="center" Background="Snow" FontWeight="Bold" FontSize="50" FontFamily="Times New Roman"><Run Language="de-de" Text="0"/></TextBlock>
        <Button x:Name="Player1_Diceroll" Content="Dice_roll" HorizontalAlignment="Left" Margin="33,308,0,0" VerticalAlignment="Top" Height="37" Width="92" Background="LightSkyBlue" FontWeight="Bold" FontSize="18" FontFamily="Times New Roman" Click="Player1_Diceroll_Click"/>
        <Button x:Name="Player2_Diceroll" Content="Dice_roll" HorizontalAlignment="Left" Margin="614,308,0,0" VerticalAlignment="Top" Height="37" Width="92" Background="LightSkyBlue" FontWeight="Bold" FontSize="18" FontFamily="Times New Roman" Click="Player2_Diceroll_Click"/>
    </Grid>
</Window>
